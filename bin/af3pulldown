#!/usr/bin/env python3

import argparse

from alphafold3_slurm.wrapper import Alphafold3PullDown


def parsing(args: list | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Takes one or more FASTA files with amino acid sequences, and submits "
            "a job array to ibex to predict the structure of each bait-prey pair."
        )
    )
    parser.add_argument(
        "--job_name",
        help="Name of the job. This is the name shown in squeue.",
        default="AF3_pulldown",
    )
    parser.add_argument(
        "--make_feature",
        help="Generate only features for the inputs.",
        action="store_true",
    )
    parser.add_argument(
        "--make_complex",
        help="Generate only complexes from existing features.",
        action="store_true",
    )
    parser.add_argument(
        "--make_both",
        help="Generate features and then complexes in one run.",
        action="store_true",
    )
    parser.add_argument(
        "--bait_type",
        help='Bait type: "protein", "ligand_ccd", "ligand_smiles", "dna", or "rna".',
        required=True,
    )
    parser.add_argument(
        "--bait_input",
        help="FASTA/CSV/TSV file(s) with bait sequences.",
        nargs="+",
        required=True,
    )
    parser.add_argument(
        "--prey_type",
        help='Prey type: "protein", "ligand_ccd", "ligand_smiles", "dna", or "rna".',
        required=True,
    )
    parser.add_argument(
        "--prey_input",
        help="FASTA/CSV/TSV file(s) with prey sequences.",
        nargs="+",
        required=True,
    )
    parser.add_argument(
        "--destination",
        help="Directory for AlphaFold inputs, outputs, scripts, and Slurm logs.",
        required=True,
    )
    parser.add_argument(
        "--feature_path",
        help="Directory containing features generated by --make_feature.",
    )
    parser.add_argument("--time", help="Minutes to allocate per job.", type=int, default=300)
    parser.add_argument("--mem", help="Memory in GB per job.", type=int, default=64)
    parser.add_argument("--mail", help="Email for job notifications.")
    parser.add_argument(
        "--gpu_type",
        help="GPU type to request (a100 or v100).",
        default="a100",
    )
    parser.add_argument(
        "--max_jobs",
        help="Maximum number of concurrent array jobs.",
        type=int,
        default=1990,
    )
    parser.add_argument(
        "--overwrite",
        help="Replace an existing generated inputs directory before writing new inputs.",
        action="store_true",
    )
    parser.add_argument(
        "--check_only",
        help="Check for completed outputs only; do not submit jobs.",
        action="store_true",
    )
    parser.add_argument(
        "--check_only_exact",
        help="Check outputs and print detailed failure information from Slurm logs.",
        action="store_true",
    )
    parser.add_argument(
        "--check_stat",
        help="Write pLDDT, ipTM, and pTM statistics for completed jobs.",
        action="store_true",
    )
    return parser.parse_args(args)


def check_parameter(args: argparse.Namespace) -> None:
    if args.make_feature + args.make_complex + args.make_both != 1:
        raise ValueError(
            "Exactly one of --make_feature, --make_complex, or --make_both must be provided."
        )
    if args.make_feature and args.feature_path is not None:
        raise ValueError("Cannot provide --feature_path with --make_feature.")
    if args.make_both and args.feature_path is not None:
        raise ValueError("Cannot provide --feature_path with --make_both.")


if __name__ == "__main__":
    args = parsing()
    check_parameter(args)

    if args.make_feature:
        job_type = "make_feature"
    elif args.make_complex:
        job_type = "make_complex"
    else:
        job_type = "both"

    Alphafold3PullDown(
        args.job_name,
        job_type,
        args.bait_type,
        args.bait_input,
        args.prey_type,
        args.prey_input,
        destination=args.destination,
        feature_path=args.feature_path,
        time_each_protein=args.time,
        memory=args.mem,
        email=args.mail,
        max_jobs=args.max_jobs,
        flag_check=args.check_only,
        flag_detailed=args.check_only_exact,
        flag_stat=args.check_stat,
        gpu_type=args.gpu_type,
        overwrite=args.overwrite,
    ).run()
